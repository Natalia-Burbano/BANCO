<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: linear-gradient(to bottom, #f0f0f0, #e0e0e0);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.uniquindio.edu.co.poo.bancouq.controller.CajeroController">

    <top>
        <VBox alignment="CENTER" style="-fx-background-color: #014a01; -fx-padding: 15;">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" text="Gestión de Cajero" />
        </VBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 20;">
            <!-- Panel de registro de clientes -->
            <TitledPane expanded="true" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Registro de Clientes">
                <VBox spacing="15" style="-fx-padding: 10;">
                    <HBox alignment="CENTER" spacing="15">
                        <Label style="-fx-font-weight: bold;" text="ID:" />
                        <TextField fx:id="idField" prefWidth="100" promptText="ID del cliente" />
                        <Label style="-fx-font-weight: bold;" text="Nombre:" />
                        <TextField fx:id="nombreField" prefWidth="200" promptText="Nombre completo" />
                        <Label style="-fx-font-weight: bold;" text="Tipo de Cuenta:" />
                        <ComboBox fx:id="tipoCuentaCombo" prefWidth="150" promptText="Seleccione tipo" />
                        <Button onAction="#registrarCliente" style="-fx-background-color: #126112; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 120; -fx-border-radius: 5;" text="Registrar Cliente">
                     <effect>
                        <DropShadow />
                     </effect></Button>
                    </HBox>
                </VBox>
            </TitledPane>

            <!-- Lista de clientes -->
            <TitledPane expanded="true" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Listado de Clientes">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TableView fx:id="clientesTable" prefHeight="200" prefWidth="400" style="-fx-border-color: #bdc3c7; -fx-border-width: 1;">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="100" text="ID" />
                            <TableColumn fx:id="nombreColumn" prefWidth="250" text="Nombre" />
                            <TableColumn fx:id="tipoCuentaColumn" prefWidth="150" text="Tipo de Cuenta" />
                        </columns>
                    </TableView>
                </VBox>
            </TitledPane>

            <!-- Panel de operaciones -->
            <TitledPane expanded="true" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Operaciones Bancarias">
                <VBox spacing="15" style="-fx-padding: 10;">
                    <HBox alignment="CENTER" spacing="15">
                        <Label style="-fx-font-weight: bold;" text="Monto:" />
                        <TextField fx:id="montoField" prefWidth="150" promptText="Ingrese monto" />
                        <Button onAction="#depositar" style="-fx-background-color: #126112; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100; -fx-border-radius: 5;" text="Depositar">
                     <effect>
                        <DropShadow />
                     </effect></Button>
                        <Button onAction="#retirar" style="-fx-background-color: #126112; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100; -fx-border-radius: 5;" text="Retirar">
                     <effect>
                        <DropShadow />
                     </effect></Button>
                        <Button onAction="#consultarSaldo" style="-fx-background-color: #126112; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 120; -fx-border-radius: 5;" text="Consultar Saldo">
                     <effect>
                        <DropShadow />
                     </effect></Button>
                    </HBox>

                    <HBox alignment="CENTER" spacing="15">
                        <Label style="-fx-font-weight: bold;" text="ID Destino:" />
                        <TextField fx:id="destinoField" prefWidth="200" promptText="ID de cuenta destino" />
                        <Button onAction="#transferir" style="-fx-background-color: #126112; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 100; -fx-border-radius: 5;" text="Transferir">
                     <effect>
                        <DropShadow />
                     </effect></Button>
                    </HBox>
                </VBox>
            </TitledPane>

            <!-- Reportes -->
            <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
                <Button onAction="#generarReporte" style="-fx-background-color: #126112; -fx-text-fill: white; -fx-font-weight: bold; -fx-min-width: 250; -fx-border-radius: 5;" text="Generar Reporte de Transacciones" />
            </HBox>
         <effect>
            <DropShadow />
         </effect>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER" style="-fx-padding: 15;">
            <Button onAction="#volver" style="-fx-background-color: #126112; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-min-width: 200; -fx-border-radius: 5;" text="Volver al Menú Principal">
            <effect>
               <DropShadow />
            </effect></Button>
        </HBox>
    </bottom>

</BorderPane>
